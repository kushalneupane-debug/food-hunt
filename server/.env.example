# Copy to .env and fill in. Never commit .env.
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=foodhunt
DB_PASSWORD=foodhunt_dev_pw
DB_NAME=foodhunt
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Generate a private JWT_SECRET in your local .env before starting.
JWT_SECRET=
# Email signup verification. Obtain these from your SMTP provider.
# Port 465 uses TLS; port 587 requires STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Phone signup: Twilio Verify generates and checks SMS codes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# VA-prefixed Service SID from the Verify request, not a VE verification SID.
TWILIO_VERIFY_SERVICE_SID=
